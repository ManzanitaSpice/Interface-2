{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manzanitaspice.github.io/Interface-2/updates/home.schema.json",
  "title": "Feed de Inicio de Interface",
  "description": "Contenido editorial y configuración del servidor que consume el launcher.",
  "type": "object",
  "required": ["schema_version", "server", "items"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": 1 },
    "server": { "$ref": "#/$defs/server" },
    "items": {
      "type": "array",
      "maxItems": 5,
      "items": { "$ref": "#/$defs/story" }
    }
  },
  "$defs": {
    "server": {
      "type": "object",
      "required": ["name", "host", "port"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "host": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "description": { "type": "string", "maxLength": 500 },
        "image_url": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
        "modpack": { "$ref": "#/$defs/modpack" }
      }
    },
    "story": {
      "type": "object",
      "required": ["id", "category", "eyebrow", "title", "description"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "category": { "type": "string", "minLength": 1, "maxLength": 42 },
        "eyebrow": { "type": "string", "minLength": 1, "maxLength": 72 },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "minLength": 1, "maxLength": 220 },
        "body": { "type": "string", "maxLength": 5000 },
        "byline": { "type": "string", "maxLength": 100 },
        "published_at": { "type": "string", "format": "date-time", "maxLength": 40 },
        "image_url": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
        "tags": {
          "type": "array",
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1, "maxLength": 32 }
        },
        "scene": { "enum": ["sunset", "portal", "dawn", "wilds", "server", "violet"] },
        "destination": { "enum": ["Mis Modpacks", "Updates"] },
        "modpack": { "$ref": "#/$defs/modpack" }
      }
    },
    "modpack": {
      "type": "object",
      "required": ["name", "imports"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "version": { "type": "string", "maxLength": 48 },
        "description": { "type": "string", "maxLength": 500 },
        "imports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/importOption" }
        }
      }
    },
    "importOption": {
      "type": "object",
      "required": ["label", "kind", "value"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "maxLength": 80 },
        "label": { "type": "string", "minLength": 1, "maxLength": 60 },
        "kind": { "enum": ["zip", "mega", "share_code"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    }
  }
}
